{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felix",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ideen-board",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "ideen-board-backups" }],
  "queues": {
    "producers": [{ "binding": "AI_QUEUE", "queue": "ideen-board-ai" }],
    "consumers": [{ "queue": "ideen-board-ai", "max_batch_size": 1, "max_retries": 2 }]
  },
  "triggers": {
    // alle 10 Min.: KI nachholen · täglich 02:17 UTC: Backup · montags 05:47 UTC: Wochenrückblick + Mail
    "crons": ["*/10 * * * *", "17 2 * * *", "47 5 * * 1"]
  },
  "observability": { "enabled": true }
}
