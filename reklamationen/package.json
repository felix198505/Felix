{
  "name": "reklamationen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply reklamationen --local",
    "db:migrate:remote": "wrangler d1 migrations apply reklamationen --remote",
    "deploy": "node scripts/deploy.mjs",
    "hash-password": "node scripts/hash-password.mjs",
    "cron:test": "curl \"http://localhost:5173/cdn-cgi/handler/scheduled?cron=13+5+*+*+*\"",
    "pruefe-import": "node scripts/pruefe-import.mjs",
    "test": "node --test --test-concurrency=1 test/app.test.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
